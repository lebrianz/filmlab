// ============================================================================
//  FILM LEBZ+  -  Film Simulation by Lebz v1  (satu file DCTL)
//
//  PASANG : salin ke folder LUT Resolve, restart Resolve, lalu
//           Color > Effects > OpenFX > DCTL > pilih "Film Lebz+".
//  MATI   : kontrol bernilai 0 = fitur mati (Grain, Halation, Aura, Blur, Dust, Weave,
//           Flicker, Vignette, Leak, Acutance, Age, Streak, Lens, Border).
//  BANDING: UTIL Before After = garis pembanding (kiri = gambar asli), 0 = mati.
//           FILM BW Filter: minus = biru, plus = merah (khusus stock hitam putih).
//  OUTPUT : Rec709, Rec709 D60, P3, P3 D60, Rec2020, HDR PQ, HDR HLG, ACEScct.
//  INPUT  : Rec709, Linear, DaVinci Intermediate, LogC3, S-Log3, V-Log, Log3G10,
//           ACEScct, F-Log, F-Log2. Gamut: Rec2020 juga dipakai untuk F-Gamut.
//  LUT    : centang "UTIL LUT Bake", klik kanan node > Generate 3D LUT
//           (hanya warna, tanpa grain/halation/dust/dll).
//  LOGO   : centang "UTIL Logo" untuk menampilkan logo FILM LEBZ+ di viewer.
//  Nilai stock adalah estimasi prosedural, bukan data film terukur.
// ============================================================================
// (tidak perlu diubah)
#define FEAT_WEAVE   1
#define FEAT_ACUTANCE 1
#define FEAT_HALATION 1
#define FEAT_GRAIN   1
#define FEAT_DUST    1
#define FEAT_LOGO    1

