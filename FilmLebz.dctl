    default: a=1.0f;b=0.0f;c=0.0f;d=0.0f;e=1.0f;f_=0.0f;g_=0.0f;h=0.0f;i=1.0f;break;
  }
  return make_float3(a*v.x+b*v.y+c*v.z, d*v.x+e*v.y+f_*v.z, g_*v.x+h*v.y+i*v.z);
