__DEVICE__ int glyphRow(int ch,int row){
  switch(ch*8+row){
    case 0: return 31;
    case 1: return 16;
    case 2: return 16;
    case 3: return 30;
    case 4: return 16;
    case 5: return 16;
    case 6: return 16;
    case 8: return 14;
    case 9: return 4;
    case 10: return 4;
    case 11: return 4;
    case 12: return 4;
    case 13: return 4;
    case 14: return 14;
    case 16: return 16;
    case 17: return 16;
    case 18: return 16;
    case 19: return 16;
    case 20: return 16;
    case 21: return 16;
    case 22: return 31;
    case 24: return 17;
    case 25: return 27;
    case 26: return 21;
    case 27: return 21;
    case 28: return 17;
    case 29: return 17;
    case 30: return 17;
    case 32: return 31;
    case 33: return 16;
    case 34: return 16;
    case 35: return 30;
    case 36: return 16;
    case 37: return 16;
    case 38: return 31;
    case 40: return 30;
    case 41: return 17;
    case 42: return 17;
    case 43: return 30;
    case 44: return 17;
    case 45: return 17;
    case 46: return 30;
    case 48: return 31;
    case 49: return 1;
    case 50: return 2;
    case 51: return 4;
    case 52: return 8;
    case 53: return 16;
    case 54: return 31;
    case 56: return 0;
    case 57: return 4;
    case 58: return 4;
    case 59: return 31;
    case 60: return 4;
    case 61: return 4;
    case 62: return 0;
    case 64: return 0;
    case 65: return 0;
    case 66: return 0;
    case 67: return 0;
    case 68: return 0;
    case 69: return 0;
    case 70: return 0;
    default: return 0;
  }
}

#if FEAT_LOGO
__DEVICE__ int logoId(int i){
  switch(i){ case 0: return 0; case 1: return 1; case 2: return 2; case 3: return 3; case 4: return 8; case 5: return 2; case 6: return 4; case 7: return 5; case 8: return 6; default: return 7; }
}
__DEVICE__ float logoMask(float x, float yTop, float s, float ox, float oy){
  float u = (x - ox) / s, v = (yTop - oy) / s;
  if (u < 0.0f || v < 0.0f || v >= 7.0f || u >= 60.0f) return 0.0f;
  int c = (int)_floor(u), r = (int)_floor(v);
  int ci = c / 6, cc = c - ci * 6;
  if (cc >= 5) return 0.0f;
  int bits = glyphRow(logoId(ci), r);
  return (float)((bits >> (4 - cc)) & 1);
}


#endif// ============================================================================
//                                  MAIN
// ============================================================================
__DEVICE__ float3 transform(int p_Width, int p_Height, int p_X, int p_Y, __TEXTURE__ p_TexR, __TEXTURE__ p_TexG, __TEXTURE__ p_TexB)
{
  const float W = (float)p_Width, H = (float)p_Height, res = W / 1920.0f;
  const float px = (float)p_X, py = (float)p_Y;
  const int frame = CURRENT_FRAME;
  const bool fx = (lutBake == 0);
  const float3 YW = make_float3(0.27411851f, 0.87363190f, -0.14775041f); // DWG luma
  const float3 YD = make_float3(0.2126f, 0.7152f, 0.0722f);


  // ---- look preset + gauge ----
  int gI = gauge; float mG = 1.0f, mH = 1.0f, mA = 1.0f, mW = 1.0f, mF = 1.0f, mD = 1.0f; bool lk = (look > 0);
  if (look == 1){ gI = 2; mG = 0.3f; mH = 0.35f; mA = 0.0f; mW = 0.0f; mF = 0.0f; mD = 0.0f; }
  else if (look == 2){ gI = 2; mG = 1.0f; mH = 1.0f; mA = 0.8f; mW = 0.5f; mF = 0.0f; mD = 0.0f; }
  else if (look == 3){ gI = 1; mG = 1.0f; mH = 1.0f; mA = 1.0f; mW = 1.0f; mF = 0.8f; mD = 0.5f; }
  else if (look == 4){ gI = 0; mG = 1.0f; mH = 1.2f; mA = 1.0f; mW = 1.0f; mF = 1.0f; mD = 1.0f; }
  else if (look == 5){ gI = 4; mG = 0.7f; mH = 0.8f; mA = 0.5f; mW = 0.3f; mF = 0.0f; mD = 0.0f; }
  else if (look == 6){ gI = 2; mG = 1.2f; mH = 1.3f; mA = 1.0f; mW = 1.0f; mF = 0.5f; mD = 1.0f; }
  const bool halE = lk ? (mH > 0.0f) : (halOn != 0);
  const bool auraE = lk ? (mA > 0.0f) : (auraOn != 0);
  const bool grE = lk ? (mG > 0.0f) : (grOn != 0);
  const bool gwE = lk ? (mW > 0.0f) : (gwAmount > 0.0f);
  const bool flE = lk ? (mF > 0.0f) : (flAmount > 0.0f);
  const bool dsE = lk ? (mD > 0.0f) : (dustAmt > 0.0f || dustScratch > 0.0f);
  const bool acE = (acuOn != 0);

  float lkShA = 0.0f, lkShH = 200.0f, lkHiA = 0.0f, lkHiH = 40.0f, lkCon = 0.0f, lkSat = 1.0f;
  if (look == 2){ lkShA = 0.45f; lkShH = 195.0f; lkHiA = 0.40f; lkHiH = 35.0f; lkCon = 0.18f; lkSat = 0.95f; }
  else if (look == 3){ lkShA = 0.40f; lkShH = 170.0f; lkHiA = 0.35f; lkHiH = 45.0f; lkCon = 0.22f; lkSat = 0.90f; }
  else if (look == 4){ lkShA = 0.20f; lkShH = 200.0f; lkHiA = 0.45f; lkHiH = 40.0f; lkCon = 0.12f; lkSat = 1.05f; }
  else if (look == 5){ lkShA = 0.25f; lkShH = 200.0f; lkHiA = 0.20f; lkHiH = 40.0f; lkCon = 0.12f; lkSat = 1.0f; }
  else if (look == 6){ lkShA = 0.35f; lkShH = 160.0f; lkHiA = 0.45f; lkHiH = 50.0f; lkCon = 0.05f; lkSat = 0.90f; }
  lkShA *= lookAmt; lkHiA *= lookAmt; lkCon *= lookAmt; lkSat = lerpf(1.0f, lkSat, lookAmt);
  Stock st = getStock(stock);

  float frameMm = 21.9f;
  float gwBase = 0.035f;
  if (gI == 0){ frameMm = 4.5f;  gwBase = 0.22f; }
  else if (gI == 1){ frameMm = 10.3f; gwBase = 0.10f; }
  else if (gI == 2){ frameMm = 21.9f; gwBase = 0.035f; }
  else if (gI == 3){ frameMm = 37.7f; gwBase = 0.03f; }
  else { frameMm = 52.5f; gwBase = 0.02f; }
  const float gfac = 21.9f / frameMm;
  const float pp = pushpull;

  // ---- gate weave (sampling position) ----
  float sx = px, sy = py;
#if FEAT_WEAVE
  if (fx && gwE){
    float sm = 1.0f, jm = 1.0f;
    if (gwStyle == 0){ sm = 0.4f; jm = 0.5f; } else if (gwStyle == 2){ sm = 2.0f; jm = 1.4f; } else if (gwStyle == 3){ sm = 2.5f; jm = 2.5f; }
    float gwA = (gwAmount > 0.0f) ? gwAmount : 1.0f;
    float amp = gwBase * 0.01f * W * gwA * sm * mW;
    float t = (float)frame * gwSpeed;
    float swX = (vn1(t, 11) - 0.5f) * 2.0f + 0.5f * (vn1(t * 2.7f, 13) - 0.5f) * 2.0f;
    float swY = (vn1(t, 17) - 0.5f) * 2.0f + 0.5f * (vn1(t * 2.3f, 19) - 0.5f) * 2.0f;
    float swR = (vn1(t * 0.8f, 23) - 0.5f) * 2.0f;
    float jX = (hash3(frame, 29, 3) - 0.5f) * 2.0f, jY = (hash3(frame, 31, 3) - 0.5f) * 2.0f, jR = (hash3(frame, 37, 3) - 0.5f) * 2.0f;
    float jx = gwJitter * jm;
    jx = _fminf(jx, 1.0f);
    float dx = amp * (swX * (1.0f - jx) + jX * jx * 0.5f) * gwH;
    float dy = amp * 0.6f * (swY * (1.0f - jx) + jY * jx * 0.5f) * gwV;
    float rot = (swR * (1.0f - jx) + jR * jx * 0.5f) * 0.0012f * gwRot * sm * mW;
    float cx = W * 0.5f, cy = H * 0.5f, rx = px - cx, ry = py - cy;
    float ca = _cosf(rot), sa = _sinf(rot);
    sx = cx + ca * rx + sa * ry - dx;
    sy = cy - sa * rx + ca * ry - dy;
  }

#endif
  // ---- flicker ----
  float flStops = 0.0f;
  if (fx && flE){
    float rnd = (hash3(frame, 41, 5) - 0.5f) * 2.0f;
    float brt = (vn1((float)frame * flSpeed, 43) - 0.5f) * 2.0f + 0.5f * (vn1((float)frame * flSpeed * 2.9f, 47) - 0.5f) * 2.0f;
    flStops = ((flAmount > 0.0f) ? flAmount : 0.3f) * 0.5f * mF * (rnd * (1.0f - flStyle) + brt * flStyle);
  }

  // ---- lens distortion ----
  if (fx && lensK != 0.0f){
    float lhx = W * 0.5f, lhy = H * 0.5f;
    float lrx = (sx - lhx) / lhx, lry = (sy - lhy) / lhx;
    float lf = 1.0f + lensK * 0.35f * (lrx * lrx + lry * lry);
    sx = lhx + lrx * lf * lhx; sy = lhy + lry * lf * lhx;
  }
  // ---- center sample (+ chroma, acutance on encoded signal) ----
  float3 enc = bilEnc(p_TexR, p_TexG, p_TexB, sx, sy, p_Width, p_Height);
  if (fx && lensCA > 0.0f){
    float chx = W * 0.5f, chy = H * 0.5f, cof = lensCA * 0.006f;
    float cdx = sx - chx, cdy = sy - chy;
    float3 eR = bilEnc(p_TexR, p_TexG, p_TexB, chx + cdx * (1.0f + cof), chy + cdy * (1.0f + cof), p_Width, p_Height);
    float3 eB = bilEnc(p_TexR, p_TexG, p_TexB, chx + cdx * (1.0f - cof), chy + cdy * (1.0f - cof), p_Width, p_Height);
    enc = make_float3(eR.x, enc.y, eB.z);
  }
#if FEAT_ACUTANCE
  if (fx && acE){
    int icx = (int)(sx + 0.5f), icy = (int)(sy + 0.5f);
    float cy0 = luma3(enc, YD);
    float rF = 1.3f * res * acuSize, rC = 9.0f * res * acuSize;
    float mF8 = cy0, mC12 = cy0;
    for (int i = 0; i < 8; i++){
      float a = (float)i * 0.785398f;
      mF8 += luma3(fetchEnc(p_TexR, p_TexG, p_TexB, icx + (int)(_cosf(a) * rF + 0.5f), icy + (int)(_sinf(a) * rF + 0.5f), p_Width, p_Height), YD);
    }
    for (int j = 0; j < 12; j++){
      float a = (float)j * 0.523599f + 0.2f;
      mC12 += luma3(fetchEnc(p_TexR, p_TexG, p_TexB, icx + (int)(_cosf(a) * rC + 0.5f), icy + (int)(_sinf(a) * rC + 0.5f), p_Width, p_Height), YD);
    }
    float dF = cy0 - mF8 / 9.0f, dC = cy0 - mC12 / 13.0f;
    float wF = lerpf(1.0f, clamp01(_fabs(dF) * 8.0f), acuEdge), wC = lerpf(1.0f, clamp01(_fabs(dC) * 8.0f), acuEdge);
    float add = acuFine * dF * wF * 1.5f + acuCoarse * dC * wC * 1.5f;
    enc = make_float3(enc.x + add, enc.y + add, enc.z + add);
  }

#endif
  // ---- film lens blur (soft lens, edges softer, optional color fringing) ----
  if (fx && blurAmt > 0.0f){
    float dxn = (px - W * 0.5f) / (W * 0.5f), dyn = (py - H * 0.5f) / (H * 0.5f);
    float r2 = (dxn * dxn + dyn * dyn) * 0.5f;
    float R = blurAmt * res * (1.0f + blurEdge * r2 * 2.0f);
    int bcx = (int)(sx + 0.5f), bcy = (int)(sy + 0.5f);
    float accR = enc.x, accG = enc.y, accB = enc.z, ws = 1.0f;
    float caR = 1.0f + blurCA * 0.5f, caB = 1.0f - blurCA * 0.5f;
    for (int i = 0; i < 24; i++){
      float rr = _sqrtf(((float)i + 0.5f) / 24.0f); float a = (float)i * 2.3999632f;
      float w = _expf(-2.2f * rr * rr); float r = rr * R;
      float ca_ = _cosf(a), sa_ = _sinf(a);
      if (blurCA > 0.0f){
        float3 tR = fetchEnc(p_TexR, p_TexG, p_TexB, bcx + (int)(ca_ * r * caR + 0.5f), bcy + (int)(sa_ * r * caR + 0.5f), p_Width, p_Height);
        float3 tG = fetchEnc(p_TexR, p_TexG, p_TexB, bcx + (int)(ca_ * r + 0.5f), bcy + (int)(sa_ * r + 0.5f), p_Width, p_Height);
        float3 tB = fetchEnc(p_TexR, p_TexG, p_TexB, bcx + (int)(ca_ * r * caB + 0.5f), bcy + (int)(sa_ * r * caB + 0.5f), p_Width, p_Height);
        accR += tR.x * w; accG += tG.y * w; accB += tB.z * w;
      } else {
        float3 tt = fetchEnc(p_TexR, p_TexG, p_TexB, bcx + (int)(ca_ * r + 0.5f), bcy + (int)(sa_ * r + 0.5f), p_Width, p_Height);
        accR += tt.x * w; accG += tt.y * w; accB += tt.z * w;
      }
      ws += w;
    }
    enc = make_float3(accR / ws, accG / ws, accB / ws);
  }

  // ---- INPUT CST -> DaVinci Wide Gamut linear ----
  float3 lin = toLin(enc, inEnc, inGamut, cstOn);

  // ---- true exposure / white balance ----
  float eg = _exp2f(exposure + flStops);
  float3 gain = make_float3(eg * _exp2f(temperature * 0.004f), eg * _exp2f(-tintv * 0.004f), eg * _exp2f(-temperature * 0.004f));
  lin = make_float3(lin.x * gain.x, lin.y * gain.y, lin.z * gain.z);

  // ---- halation / aura (applied to scene exposure) ----
  const int tapsN = (halQual == 0) ? 16 : ((halQual == 1) ? 32 : 56);
  const float halS = halStrength * st.hal * mH;
  const float auS = auraStrength * st.aura * mA;
#if FEAT_HALATION
  if (fx && (halE || auraE)){
    int icx = (int)(sx + 0.5f), icy = (int)(sy + 0.5f);
    if (halE){
      float R = _fminf(0.006f * W * halRadius * gfac, 0.08f * W);
      float hsum = 0.0f, wsum = 0.3f; float3 blur = make_float3(lin.x * 0.3f, lin.y * 0.3f, lin.z * 0.3f);
      for (int i = 0; i < tapsN; i++){
        float rr = ((float)i + 0.5f) / (float)tapsN; float a = (float)i * 2.3999632f;
        float r = rr * R;
        float3 l = toLin(fetchEnc(p_TexR, p_TexG, p_TexB, icx + (int)(_cosf(a) * r + 0.5f), icy + (int)(_sinf(a) * r + 0.5f), p_Width, p_Height), inEnc, inGamut, cstOn);
        l = make_float3(l.x * gain.x, l.y * gain.y, l.z * gain.z);
        float w = (0.15f + rr) * _expf(-4.0f * rr * rr);
        hsum += w * _fmaxf(luma3(l, YW) - halThresh, 0.0f);
        blur = make_float3(blur.x + l.x * w, blur.y + l.y * w, blur.z + l.z * w); wsum += w;
      }
      hsum /= wsum; blur = make_float3(blur.x / wsum, blur.y / wsum, blur.z / wsum);
      float3 hc = make_float3(1.0f * halBiasR, lerpf(0.55f, 0.12f, st.red) * halBiasG, lerpf(0.12f, 0.01f, st.red) * halBiasB);
      float hl = luma3(hc, YW); hc = make_float3(hl + (hc.x - hl) * halSat, hl + (hc.y - hl) * halSat, hl + (hc.z - hl) * halSat);
      float k = hsum * halS * 0.45f;
      float sf = halSoft * clamp01(halS) * 0.6f;
      lin = make_float3(lerpf(lin.x, blur.x, sf) + hc.x * k, lerpf(lin.y, blur.y, sf) + hc.y * k, lerpf(lin.z, blur.z, sf) + hc.z * k);
    }
    if (auraE){
      float R = _fminf(0.06f * W * auraRadius * _sqrtf(gfac), 0.35f * W);
      float asum = 0.0f, wsum = 0.0001f;
      for (int i = 0; i < tapsN * 2; i++){
        float rr = ((float)i + 0.5f) / (float)(tapsN * 2); float a = (float)i * 2.3999632f + 1.0f;
        float r = rr * R;
        float3 l = toLin(fetchEnc(p_TexR, p_TexG, p_TexB, icx + (int)(_cosf(a) * r + 0.5f), icy + (int)(_sinf(a) * r + 0.5f), p_Width, p_Height), inEnc, inGamut, cstOn);
        l = make_float3(l.x * gain.x, l.y * gain.y, l.z * gain.z);
        float w = (0.1f + rr) * _expf(-2.6f * rr);
        asum += w * _fmaxf(luma3(l, YW) - auraThresh, 0.0f); wsum += w;
      }
      asum /= wsum;
      float3 ac = make_float3(1.0f, lerpf(0.35f, 0.9f, auraGreen), lerpf(0.05f, 0.25f, auraGreen));
      float k = asum * auS * 0.6f;
      lin = make_float3(lin.x + ac.x * k, lin.y + ac.y * k, lin.z + ac.z * k);
    }
  }

#endif
#if FEAT_HALATION
  if (fx && streakAmt > 0.0f){
    int stx = (int)(sx + 0.5f), sty = (int)(sy + 0.5f);
    float Rl = 0.12f * W * streakLen; float ssum = 0.0f, swt = 0.0001f;
    for (int i = 0; i < 24; i++){
      float rr = ((float)i + 0.5f) / 24.0f; float w = _expf(-3.0f * rr); int off = (int)(rr * Rl);
      float3 l1 = toLin(fetchEnc(p_TexR, p_TexG, p_TexB, stx + off, sty, p_Width, p_Height), inEnc, inGamut, cstOn);
      float3 l2 = toLin(fetchEnc(p_TexR, p_TexG, p_TexB, stx - off, sty, p_Width, p_Height), inEnc, inGamut, cstOn);
      l1 = make_float3(l1.x * gain.x, l1.y * gain.y, l1.z * gain.z); l2 = make_float3(l2.x * gain.x, l2.y * gain.y, l2.z * gain.z);
      ssum += w * (_fmaxf(luma3(l1, YW) - 0.75f, 0.0f) + _fmaxf(luma3(l2, YW) - 0.75f, 0.0f)); swt += 2.0f * w;
    }
    float ks = (ssum / swt) * streakAmt * 1.2f;
    lin = make_float3(lin.x + ks * 0.35f, lin.y + ks * 0.6f, lin.z + ks * 1.0f);
  }
#endif

  // ---- mono stocks: spectral response ----
  if (st.mono > 0.5f){
    float3 mw = make_float3(0.27f, 0.62f, 0.11f);
    if (st.mono > 1.5f && st.mono < 2.5f) mw = make_float3(0.04f, 0.50f, 0.46f);
    else if (st.mono > 2.5f) mw = make_float3(0.55f, 0.32f, 0.13f);
    if (bwFilt > 0.0f) mw = make_float3(lerpf(mw.x, 0.62f, bwFilt), lerpf(mw.y, 0.34f, bwFilt), lerpf(mw.z, 0.04f, bwFilt));
    else if (bwFilt < 0.0f){ float bfk = -bwFilt; mw = make_float3(lerpf(mw.x, 0.04f, bfk), lerpf(mw.y, 0.36f, bfk), lerpf(mw.z, 0.60f, bfk)); }
    float ym = _fmaxf(luma3(lin, mw), 0.0f);
    lin = make_float3(ym, ym, ym);
  }

  // ---- NEGATIVE ----
  const float xo = st.xover * printColor;
  float3 ng = make_float3(_exp2f(0.20f * st.warm), _exp2f(0.12f * st.tint), _exp2f(-0.20f * st.warm));
  if (st.mono > 0.5f) ng = make_float3(1.0f, 1.0f, 1.0f);
  float3 x3 = make_float3(
    _log10f(_fmaxf(lin.x * ng.x, 1e-6f) / 0.18f),
    _log10f(_fmaxf(lin.y * ng.y, 1e-6f) / 0.18f),
    _log10f(_fmaxf(lin.z * ng.z, 1e-6f) / 0.18f));
  const float gn0 = 0.60f * (1.0f + 0.10f * pp);
  const float ltn = _fmaxf(1.05f * (1.0f - 0.10f * pp), 0.4f), lsn = 1.6f;
  float3 Dn = make_float3(
    hd(x3.x, gn0 * (1.0f + 0.06f * xo), ltn, lsn),
    hd(x3.y, gn0, ltn, lsn),
    hd(x3.z, gn0 * (1.0f - 0.06f * xo), ltn, lsn));

  // ---- PRINT / TELECINE ----
  float gpS = 2.25f, ltS = 0.82f, lsS = 3.4f;
  if (printStyle == 1){ gpS = 2.5f; ltS = 0.78f; lsS = 2.0f; }
  else if (printStyle == 2){ gpS = 1.9f; ltS = 1.15f; lsS = 2.6f; }
  const float gpT = 1.9f, ltT = 1.15f, lsT = 2.6f;
  float gp = lerpf(gpS, gpT, tcBlend) * st.contrast * printContrast * (1.0f + 0.12f * _fmaxf(pp, 0.0f) * 0.5f + 0.06f * _fminf(pp, 0.0f)) * (1.0f - 0.12f * filmAge);
  float lt = lerpf(ltS, ltT, tcBlend), ls = lerpf(lsS, lsT, tcBlend);
  lt *= (1.0f + 0.45f * shoAmt); ls *= (1.0f - 0.35f * toeAmt);
  const float dpc = 0.80f;
  float3 pl = make_float3((plR + plM) * 0.025f, (plG + plM) * 0.025f, (plB + plM) * 0.025f);
  float3 Dp = make_float3(
    dpc + hd(-Dn.x + pl.x, gp * (1.0f + 0.08f * xo), lt, ls),
    dpc + hd(-Dn.y + pl.y, gp, lt, ls),
    dpc + hd(-Dn.z + pl.z, gp * (1.0f - 0.08f * xo), lt, ls));
  float3 o = make_float3(_powf(10.0f, -Dp.x), _powf(10.0f, -Dp.y), _powf(10.0f, -Dp.z));

  // base fog / push fog / black point
  float lift = st.lift + 0.004f * _fmaxf(pp, 0.0f) - 0.0015f * _fmaxf(-pp, 0.0f) + 0.035f * filmAge;
  float lr = lift * (1.0f - fogReduce);
  o = make_float3(o.x * (1.0f - lr) + lr, o.y * (1.0f - lr) + lr, o.z * (1.0f - lr) + lr);
  o = make_float3(o.x + blackPoint, o.y + blackPoint, o.z + blackPoint);

  // ---- LAB ----
  float yL = luma3(o, YW);
  float mx = _fmaxf(o.x, _fmaxf(o.y, o.z)), mn = _fminf(o.x, _fminf(o.y, o.z));
  float sMeas = (mx > 1e-5f) ? clamp01((mx - mn) / mx) : 0.0f;
  float satT = (1.0f + (st.sat - 1.0f) * printColor) * richness * lkSat * (1.0f + 0.06f * pp) * (1.0f - 0.3f * filmAge);
  if (st.mono > 0.5f) satT = 0.0f;
  float vibF = 0.0f;
  if (vibrance != 0.0f){
    float hh = rgbHue(make_float3(o.x, o.y, o.z)); float hd_ = _fabs(hh - 28.0f); if (hd_ > 180.0f) hd_ = 360.0f - hd_;
    float skin = _expf(-(hd_ / 24.0f) * (hd_ / 24.0f));
    vibF = vibrance * (1.0f - sMeas) * (1.0f - 0.75f * skin);
  }
  float sTot = satT * (1.0f + vibF);
  o = make_float3(yL + (o.x - yL) * sTot, yL + (o.y - yL) * sTot, yL + (o.z - yL) * sTot);
  float dd = _exp2f(-hiSatDens * 1.2f * sMeas * sMeas);
  o = make_float3(o.x * dd, o.y * dd, o.z * dd);
  float hsA = hueShift + 0.4f * filmAge;
  if (hsA != 0.0f){
    float ha = 0.10f * hsA, hb = 0.08f * hsA;
    o = make_float3((1.0f - ha) * o.x + ha * o.y, (1.0f - hb) * o.y + hb * o.z, o.z);
  }
  if (filmAge > 0.0f) o = make_float3(o.x * (1.0f + 0.07f * filmAge), o.y * (1.0f + 0.01f * filmAge), o.z * (1.0f - 0.14f * filmAge));
  if (neutralize > 0.0f){
    float yN = luma3(o, YW); float w = neutralize * (1.0f - sstep(0.0f, 0.25f, sMeas));
    o = make_float3(lerpf(o.x, yN, w), lerpf(o.y, yN, w), lerpf(o.z, yN, w));
  }
  float labC = labContrast + lkCon;
  if (labC != 0.0f){
    float yC = _fmaxf(luma3(o, YW), 1e-5f);
    float ce = 1.0f + 0.4f * labC; ce = 1.0f + (ce - 1.0f) * (1.0f - sstep(0.55f, 1.0f, yC));
    float ratio = _powf(yC / 0.16f, ce - 1.0f);
    o = make_float3(o.x * ratio, o.y * ratio, o.z * ratio);
  }
  o = splitTone(o, stShHue, stShAmt, stHiHue, stHiAmt, stBal, stSoft, YW);
  if (lk) o = splitTone(o, lkShH, lkShA, lkHiH, lkHiA, 0.0f, 0.5f, YW);
  if (st.mono > 0.5f) o = make_float3(o.x * (1.0f + 0.05f * st.warm), o.y, o.z * (1.0f - 0.05f * st.warm));

  // ---- OUTPUT gamut ----
  int og = 0; bool d60 = false; bool isHdr = false; bool isAces = false; float dgam = 2.4f;
  if (outSpace == 1){ d60 = true; }
  else if (outSpace == 2){ og = 1; dgam = 2.6f; }
  else if (outSpace == 3){ og = 1; d60 = true; dgam = 2.6f; }
  else if (outSpace == 4){ og = 2; }
  else if (outSpace == 5 || outSpace == 6){ og = 2; isHdr = true; }
  else if (outSpace == 7){ og = 3; isAces = true; }
  float3 od = fromWorkM(o, og);
  if (d60) od = d60M(od, og);
  {
    float3 yw = make_float3(0.2126f, 0.7152f, 0.0722f);
    if (og == 1) yw = make_float3(0.2290f, 0.6917f, 0.0793f); else if (og == 2) yw = make_float3(0.2627f, 0.6780f, 0.0593f); else if (og == 3) yw = make_float3(0.2722f, 0.6741f, 0.0537f);
    float yo = luma3(od, yw); float mnv = _fminf(od.x, _fminf(od.y, od.z));
    if (mnv < 0.0f && yo > 0.0f){ float tt = clamp01(-mnv / (yo - mnv)); od = make_float3(od.x + (yo - od.x) * tt, od.y + (yo - od.y) * tt, od.z + (yo - od.z) * tt); }
  }
  if (fx && vigAmt > 0.0f){
    float vx = (px - W * 0.5f) / (W * 0.5f), vy = (py - H * 0.5f) / (H * 0.5f);
    float vr = _sqrtf(vx * vx + vy * vy) * 0.7071f;
    float vg = 1.0f - vigAmt * sstep(vigSize, 1.05f, vr);
    od = make_float3(od.x * vg, od.y * vg, od.z * vg);
  }
  if (fx && leakAmt > 0.0f){
    int lkb = frame / 72;
    float lside = (hash3(lkb, 71, 9) < 0.5f) ? 1.0f : 0.0f;
    float ldd = (lside > 0.5f) ? px / W : 1.0f - px / W;
    float lpulse = 0.35f + 0.65f * vn1((float)frame * 0.05f, 61);
    float lshape = _expf(-ldd * 4.0f) * (0.65f + 0.35f * vn1(py / (H * 0.35f) + (float)lkb * 3.1f, 67));
    float lk2 = leakAmt * lpulse * lshape * 0.9f;
    od = make_float3(od.x + lk2, od.y + lk2 * 0.32f, od.z + lk2 * 0.06f);
  }
  od = make_float3(_fmaxf(od.x, 0.0f), _fmaxf(od.y, 0.0f), _fmaxf(od.z, 0.0f));
  const float ig = 1.0f / dgam;
  float3 code = make_float3(_powf(_fminf(od.x, 8.0f), ig), _powf(_fminf(od.y, 8.0f), ig), _powf(_fminf(od.z, 8.0f), ig));

  // ---- GRAIN (in display code) ----
  float yd = clamp01(luma3(code, YD));
  float zw = 1.0f;
  if (grE || zFalse != 0){
    float v0, v1, v2, v3, v4, v5, v6, v7, v8;
    if (zoneMode == 0){
      v0 = zShadow; v1 = zShadow; v2 = lerpf(zShadow, zMid, 0.33f); v3 = lerpf(zShadow, zMid, 0.67f); v4 = zMid;
      v5 = lerpf(zMid, zHigh, 0.33f); v6 = lerpf(zMid, zHigh, 0.67f); v7 = zHigh; v8 = zHigh;
    } else { v0 = z0; v1 = z1; v2 = z2; v3 = z3; v4 = z4; v5 = z5; v6 = z6; v7 = z7; v8 = z8; }
    if (v0 + v1 + v2 + v3 + v4 + v5 + v6 + v7 + v8 < 0.001f){ v0 = 0.5f; v1 = 0.8f; v2 = 1.0f; v3 = 1.1f; v4 = 1.0f; v5 = 0.85f; v6 = 0.65f; v7 = 0.45f; v8 = 0.25f; }
    float tz = yd * 8.0f; int zi = (int)_floor(tz); if (zi > 7) zi = 7; float zf = tz - (float)zi;
    zw = lerpf(zonePick(zi, v0, v1, v2, v3, v4, v5, v6, v7, v8), zonePick(zi + 1, v0, v1, v2, v3, v4, v5, v6, v7, v8), zf);
  }
#if FEAT_GRAIN
  if (fx && grE){
    float grainUm = 5.0f * _powf(st.iso / 200.0f, 0.35f);
    float cell = _fmaxf(grainUm * W / (frameMm * 1000.0f) * grSize, 1.2f);
    float cw = cell * grAnam;
    float sigma = 0.048f * grAmount * st.grain * mG * _powf(st.iso / 200.0f, 0.25f) * _powf(gfac, 0.25f) * (1.0f + 0.25f * pp) * (1.0f + 0.6f * filmAge);
    float rn = 1.0f / _sqrtf(1.0f + grRough * grRough);
    float nm = gnoise(px, py, cw, cell, 1, frame, grSoft); nm = (nm + grRough * gnoise(px, py, cw * 0.5f, cell * 0.5f, 51, frame, grSoft)) * rn;
    float nr = gnoise(px, py, cw, cell, 2, frame, grSoft); nr = (nr + grRough * gnoise(px, py, cw * 0.5f, cell * 0.5f, 52, frame, grSoft)) * rn;
    float ngc = gnoise(px, py, cw, cell, 3, frame, grSoft); ngc = (ngc + grRough * gnoise(px, py, cw * 0.5f, cell * 0.5f, 53, frame, grSoft)) * rn;
    float nb = gnoise(px, py, cw, cell, 4, frame, grSoft); nb = (nb + grRough * gnoise(px, py, cw * 0.5f, cell * 0.5f, 54, frame, grSoft)) * rn;
    if (grStreak > 0.0f){
      float sn = gnoise(px, py, cw, cell * grStreakLen, 90, frame, 1.0f) * grStreak;
      nm += sn * 0.6f; nr += sn * 0.4f; ngc += sn * 0.4f; nb += sn * 0.4f;
    }
    float mxR = grMixR, mxG = grMixG, mxB = grMixB, gLt = grLight, gDk = grDark;
    if (mxR + mxG + mxB < 0.001f){ mxR = 1.0f; mxG = 1.0f; mxB = 1.2f; }
    if (gLt + gDk < 0.001f){ gLt = 1.0f; gDk = 1.0f; }
    float gr = lerpf(nm, nr, grSat) * mxR, gg = lerpf(nm, ngc, grSat) * mxG, gb = lerpf(nm, nb, grSat) * mxB;
    if (st.mono > 0.5f){ gr = nm; gg = nm; gb = nm; }
    gr *= (gr > 0.0f) ? gLt : gDk; gg *= (gg > 0.0f) ? gLt : gDk; gb *= (gb > 0.0f) ? gLt : gDk;
    float k = sigma * zw;
    code = make_float3(code.x + gr * k, code.y + gg * k, code.z + gb * k);
  }

#endif
  // ---- DUST / SCRATCH / HAIR ----
#if FEAT_DUST
  if (fx && dsE){
    float dOn = (dustAmt > 0.0f || dustScratch > 0.0f) ? 1.0f : 0.0f;
    float sA = (dOn > 0.5f) ? dustAmt : 1.0f; float scA = (dOn > 0.5f) ? dustScratch : 0.7f;
    float pf = (dustProfile == 0) ? 0.25f : ((dustProfile == 1) ? 1.0f : ((dustProfile == 2) ? 2.4f : 4.5f));
    int fd = frame / (int)dustHold, fs = frame / (int)scratchHold;
    float lp = dustPolar;
    float dark = 0.0f, light = 0.0f;
    float2 s1 = specks(px, py, 90.0f * res, fd, 1, 0.16f * pf * sA * mD, 3.0f * res * dustSize, lp);
    float2 s2 = specks(px, py, 260.0f * res, fd, 2, 0.02f * pf * sA * mD, 9.0f * res * dustSize, lp);
    float2 hr = hairs(px, py, 300.0f * res, fd, 0.05f * pf * scA * mD, res, lp);
    float2 sc = scratches(px, py, W, H, res, fs, 0.025f * pf * scA * mD, lp);
    dark = _fmaxf(_fmaxf(s1.x, s2.x), _fmaxf(hr.x, sc.x));
    light = _fmaxf(_fmaxf(s1.y, s2.y), _fmaxf(hr.y, sc.y));
    float ds = 0.7f;
    code = make_float3(code.x * (1.0f - dark * ds * 0.9f) + light * ds * 0.85f, code.y * (1.0f - dark * ds * 0.9f) + light * ds * 0.85f, code.z * (1.0f - dark * ds * 0.9f) + light * ds * 0.85f);
  }

#endif
  // ---- false colour for zones ----
  if (zFalse != 0){
    int zc = (int)_floor(yd * 8.0f + 0.5f);
    float3 fc = make_float3(0.2f, 0.0f, 0.4f);
    if (zc == 1) fc = make_float3(0.1f, 0.1f, 0.8f); else if (zc == 2) fc = make_float3(0.0f, 0.5f, 0.9f);
    else if (zc == 3) fc = make_float3(0.0f, 0.7f, 0.5f); else if (zc == 4) fc = make_float3(0.3f, 0.7f, 0.2f);
    else if (zc == 5) fc = make_float3(0.8f, 0.8f, 0.1f); else if (zc == 6) fc = make_float3(0.95f, 0.55f, 0.1f);
    else if (zc == 7) fc = make_float3(0.9f, 0.2f, 0.15f); else if (zc >= 8) fc = make_float3(1.0f, 0.6f, 0.7f);
    code = fc;
  }

  // ---- back to linear, final encode ----
  float3 fin;
  float3 lo = make_float3(_powf(_fmaxf(code.x, 0.0f), dgam), _powf(_fmaxf(code.y, 0.0f), dgam), _powf(_fmaxf(code.z, 0.0f), dgam));
  if (isAces){
    fin = make_float3(acesCct(lo.x * 1.125f), acesCct(lo.y * 1.125f), acesCct(lo.z * 1.125f));
  } else if (!isHdr){
    fin = make_float3(clamp01(_powf(lo.x, ig)), clamp01(_powf(lo.y, ig)), clamp01(_powf(lo.z, ig)));
  } else {
    float pk = hdrPeak / 100.0f;
    float ex = (pk - 1.0f) * hdrUnroll / 0.4f;
    float vx = lo.x, vy = lo.y, vz = lo.z;
    if (vx > 0.6f) { vx = 0.6f + (vx - 0.6f) * (1.0f + ex); }
    if (vy > 0.6f) { vy = 0.6f + (vy - 0.6f) * (1.0f + ex); }
    if (vz > 0.6f) { vz = 0.6f + (vz - 0.6f) * (1.0f + ex); }
    if (outSpace == 6) fin = make_float3(clamp01(hlgEnc(vx * 0.1f)), clamp01(hlgEnc(vy * 0.1f)), clamp01(hlgEnc(vz * 0.1f)));
    else fin = make_float3(clamp01(pqEnc(vx * 100.0f)), clamp01(pqEnc(vy * 100.0f)), clamp01(pqEnc(vz * 100.0f)));
  }

  // ---- before/after divider ----
  if (fx && splitPos > 0.0f){
    float spx = splitPos * W;
    if (px < spx) fin = fetchEnc(p_TexR, p_TexG, p_TexB, p_X, p_Y, p_Width, p_Height);
    if (_fabs(px - spx) < 1.5f * res) fin = make_float3(1.0f, 1.0f, 1.0f);
  }
  // ---- film frame border + sprocket holes ----
  if (fx && borderAmt > 0.0f){
    float bt = borderAmt * 0.07f * H, bs = borderAmt * 0.03f * W;
    if (sprocketAmt > 0.0f) bs = _fmaxf(bs, 0.07f * W * _fminf(borderAmt * 4.0f, 1.0f));
    float hw = W * 0.5f - bs, hh = H * 0.5f - bt;
    float cr = _fminf(0.03f * H, _fminf(hw, hh) * 0.5f);
    float qx = _fabs(px - W * 0.5f) - (hw - cr), qy = _fabs(py - H * 0.5f) - (hh - cr);
    float sdb = _sqrtf(_fmaxf(qx, 0.0f) * _fmaxf(qx, 0.0f) + _fmaxf(qy, 0.0f) * _fmaxf(qy, 0.0f)) + _fminf(_fmaxf(qx, qy), 0.0f) - cr;
    if (sdb > 0.0f){
      float3 bc = make_float3(0.035f, 0.028f, 0.022f);
      if (sprocketAmt > 0.0f && (px < bs || px > W - bs)){
        float hwid = bs * 0.45f; float hht = hwid * 1.35f; float pitch = hwid * 3.0f;
        float hxc = (px < bs) ? bs * 0.5f : W - bs * 0.5f;
        float ph = py - _floor(py / pitch) * pitch - pitch * 0.5f;
        float rr = hwid * 0.2f;
        float ddx = _fabs(px - hxc) - (hwid * 0.5f - rr), ddy = _fabs(ph) - (hht * 0.5f - rr);
        float sdh = _sqrtf(_fmaxf(ddx, 0.0f) * _fmaxf(ddx, 0.0f) + _fmaxf(ddy, 0.0f) * _fmaxf(ddy, 0.0f)) + _fminf(_fmaxf(ddx, ddy), 0.0f) - rr;
        if (sdh < 0.0f) bc = make_float3(lerpf(0.035f, 0.95f, sprocketAmt), lerpf(0.028f, 0.92f, sprocketAmt), lerpf(0.022f, 0.85f, sprocketAmt));
      }
      fin = bc;
    }
  }

  // ---- pixel logo overlay ----
#if FEAT_LOGO
  if (showLogo != 0){
    float s = _fmaxf(2.0f, _floor(W * 0.0028f));
    float ox = W * 0.03f, oy = H * 0.04f;
    float yTop = py;
    float m = logoMask(px, yTop, s, ox, oy);
    float sh = logoMask(px - s * 0.7f, yTop - s * 0.7f, s, ox, oy);
    if (sh > 0.5f) fin = make_float3(fin.x * 0.25f, fin.y * 0.25f, fin.z * 0.25f);
    if (m > 0.5f) fin = make_float3(1.0f, 0.54f, 0.12f);
  }
#endif
  if (!(fin.x == fin.x)) fin.x = 0.0f;
  if (!(fin.y == fin.y)) fin.y = 0.0f;
  if (!(fin.z == fin.z)) fin.z = 0.0f;
  return fin;
}
