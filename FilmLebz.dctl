__DEVICE__ Stock mk(float a, float b, float c, float d, float e, float f_, float g_, float h, float i, float j, float k, float l){
  Stock s; s.iso = a; s.contrast = b; s.sat = c; s.warm = d; s.tint = e; s.xover = f_; s.lift = g_; s.hal = h; s.aura = i; s.mono = j; s.red = k; s.grain = l; return s;
}
