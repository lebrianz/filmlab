__DEVICE__ float decodeTF(float v, int tf){
  if (tf == 0) return _powf(_fmaxf(v, 0.0f), 2.4f);
  if (tf == 1) return v;
  if (tf == 2){ // DaVinci Intermediate
    return (v <= 0.02740668f) ? v / 10.44426855f : _exp2f(v / 0.07329248f - 7.0f) - 0.0075f;
  }
  if (tf == 3){ // ARRI LogC3 EI800
    return (v > 0.1496582f) ? (_powf(10.0f, (v - 0.385537f) / 0.247190f) - 0.052272f) / 5.555556f : (v - 0.092809f) / 5.367655f;
  }
  if (tf == 4){ // Sony S-Log3
    return (v >= 0.1673609920f) ? _powf(10.0f, (v * 1023.0f - 420.0f) / 261.5f) * 0.19f - 0.01f : (v * 1023.0f - 95.0f) * 0.01125f / (171.2102946929f - 95.0f);
  }
  if (tf == 5){ // Panasonic V-Log
    return (v < 0.181f) ? (v - 0.125f) / 5.6f : _powf(10.0f, (v - 0.598206f) / 0.241514f) - 0.00873f;
  }
  if (tf == 8){ // Fujifilm F-Log
    return (v >= 0.100537775223865f) ? (_powf(10.0f, (v - 0.790453f) / 0.344676f) - 0.009468f) / 0.555556f : (v - 0.092864f) / 8.735631f;
  }
  if (tf == 9){ // Fujifilm F-Log2
    return (v >= 0.100686685370811f) ? (_powf(10.0f, (v - 0.384316f) / 0.245281f) - 0.064829f) / 5.555556f : (v - 0.092864f) / 8.799461f;
  }
  if (tf == 7){ return (v <= 0.155251141552511f) ? (v - 0.0729055341958355f) / 10.5402377416545f : _exp2f(v * 17.52f - 9.72f); }
  // RED Log3G10
  return (v < 0.0f) ? v / 15.1927f - 0.01f : (_powf(10.0f, v / 0.224282f) - 1.0f) / 155.975327f - 0.01f;
}
__DEVICE__ float3 toLin(float3 e, int tf, int gm, int cst){
  if (cst == 0) return e; // bypass: assume DaVinci Wide Gamut linear
  float3 l = make_float3(decodeTF(e.x, tf), decodeTF(e.y, tf), decodeTF(e.z, tf));
  return toWorkM(l, gm);
}
__DEVICE__ float pqEnc(float nits){
  float y = _powf(_fmaxf(nits, 0.0f) / 10000.0f, 0.1593017578125f);
  return _powf((0.8359375f + 18.8515625f * y) / (1.0f + 18.6875f * y), 78.84375f);
}
__DEVICE__ float hlgEnc(float e){
  e = _fmaxf(e, 0.0f);
  return (e <= 1.0f / 12.0f) ? _sqrtf(3.0f * e) : 0.17883277f * _logf(12.0f * e - 0.28466892f) + 0.55991073f;
}
__DEVICE__ float3 hue2rgb(float h){
  h = h / 60.0f; float k = h - 6.0f * _floor(h / 6.0f);
  float r = clamp01(_fabs(k - 3.0f) - 1.0f), g = clamp01(2.0f - _fabs(k - 2.0f)), b = clamp01(2.0f - _fabs(k - 4.0f));
  return make_float3(r, g, b);
}
__DEVICE__ float rgbHue(float3 c){
  float mx = _fmaxf(c.x, _fmaxf(c.y, c.z)), mn = _fminf(c.x, _fminf(c.y, c.z)); float d = mx - mn;
  if (d < 1e-6f) return 0.0f;
  float h;
  if (mx == c.x) h = (c.y - c.z) / d; else if (mx == c.y) h = 2.0f + (c.z - c.x) / d; else h = 4.0f + (c.x - c.y) / d;
  h *= 60.0f; if (h < 0.0f) h += 360.0f; return h;
}

__DEVICE__ float3 splitTone(float3 o, float shH, float shA, float hiH, float hiA, float bal, float soft, float3 YW){
  if (shA <= 0.0f && hiA <= 0.0f) return o;
  float yS = _sqrtf(clamp01(luma3(o, YW)));
  float piv = 0.5f + 0.3f * bal, wd = 0.15f + 0.35f * soft;
  float wH = sstep(piv - wd, piv + wd, yS), wS = 1.0f - wH;
  float3 cs = hue2rgb(shH), ch = hue2rgb(hiH);
  float ks = shA * wS * 0.6f, kh = hiA * wH * 0.6f;
  float ms = (cs.x + cs.y + cs.z) / 3.0f, mh = (ch.x + ch.y + ch.z) / 3.0f;
  return make_float3(o.x * (1.0f + (cs.x - ms) * ks + (ch.x - mh) * kh), o.y * (1.0f + (cs.y - ms) * ks + (ch.y - mh) * kh), o.z * (1.0f + (cs.z - ms) * ks + (ch.z - mh) * kh));
}
__DEVICE__ float acesCct(float x){ return (x <= 0.0078125f) ? 10.5402377416545f * x + 0.0729055341958355f : (_log2f(_fmaxf(x, 1e-9f)) + 9.72f) / 17.52f; }

