    case 9: a=0.91467753f;b=0.00447906f;c=0.08084341f;d=0.03079375f;e=0.78450535f;f_=0.18470090f;g_=0.06741276f;h=0.08295544f;i=0.84963181f;break;
    case 10: a=1.32792835f;b=-0.21155035f;c=-0.11637800f;d=-0.01382559f;e=0.91436124f;f_=0.09946435f;g_=0.09856064f;h=0.07650545f;i=0.82493392f;break;
