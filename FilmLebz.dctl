// ---- nilai tetap (kontrol lama yang disederhanakan) ----
#define cstOn 1
#define frameOffset 0
#define grOn (grAmount > 0.0f)
#define grSoft (0.65f - 0.3f * grRough)
#define grSat 0.7f
#define grMixR 1.0f
#define grMixG 1.0f
#define grMixB 1.2f
#define grStreak 0.0f
