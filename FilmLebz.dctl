__DEVICE__ int wrapFrame(int f){ if (f < 0) f = -f; return f - (f / 8192) * 8192; }
#define CURRENT_FRAME wrapFrame((int)TIMELINE_FRAME_INDEX + (int)frameOffset)



// ============================ MATH HELPERS ==================================
__DEVICE__ float lerpf(float a, float b, float t){ return a + (b - a) * t; }
__DEVICE__ float clamp01(float x){ return _fminf(_fmaxf(x, 0.0f), 1.0f); }
__DEVICE__ float sstep(float a, float b, float x){ float t = clamp01((x - a) / (b - a)); return t * t * (3.0f - 2.0f * t); }
__DEVICE__ float tanh_(float x){ x = _fminf(_fmaxf(x, -15.0f), 15.0f); float e = _expf(2.0f * x); return (e - 1.0f) / (e + 1.0f); }
__DEVICE__ float luma3(float3 c, float3 w){ return c.x * w.x + c.y * w.y + c.z * w.z; }

// H&D style curve: t = relative log exposure, g = slope, lt = toe depth, ls = shoulder depth
__DEVICE__ float hd(float t, float g, float lt, float ls){
  return (t >= 0.0f) ? ls * tanh_(g * t / ls) : -lt * tanh_(-g * t / lt);
}

// ------------------------------ HASH / NOISE --------------------------------
__DEVICE__ unsigned int pcg(unsigned int v){
  unsigned int s = v * 747796405u + 2891336453u;
  unsigned int w = ((s >> ((s >> 28u) + 4u)) ^ s) * 277803737u;
  return (w >> 22u) ^ w;
}
__DEVICE__ float hash3(int a, int b, int c){
  unsigned int h = pcg((unsigned int)a * 1597334677u ^ pcg((unsigned int)b * 3812015801u ^ pcg((unsigned int)c + 1013904223u)));
  return (float)(h & 16777215u) / 16777216.0f;
}
__DEVICE__ float vn1(float t, int seed){
  float i = _floor(t); float f = t - i; f = f * f * (3.0f - 2.0f * f);
  return lerpf(hash3((int)i, seed, 7), hash3((int)i + 1, seed, 7), f);
}
// 2D noise, ~unit variance, soft=0 -> blocky cells, soft=1 -> smooth
__DEVICE__ float gnoise(float x, float y, float cw, float chh, int seed, int fr, float soft){
  float u = x / cw, v = y / chh;
  float iu = _floor(u), iv = _floor(v);
  float fu = u - iu, fv = v - iv;
  int a = (int)iu, b = (int)iv;
  int s = fr * 977 + seed;
  float h00 = hash3(a, b, s), h10 = hash3(a + 1, b, s), h01 = hash3(a, b + 1, s), h11 = hash3(a + 1, b + 1, s);
  fu = fu * fu * (3.0f - 2.0f * fu); fv = fv * fv * (3.0f - 2.0f * fv);
  float sm = lerpf(lerpf(h00, h10, fu), lerpf(h01, h11, fu), fv);
  float n = (lerpf(h00, sm, soft) - 0.5f) * lerpf(3.46f, 5.2f, soft);
  return _fminf(_fmaxf(n, -3.0f), 3.0f);
}

