#define grLight 1.0f
#define grDark 1.0f
#define zoneMode 1
#define zShadow 1.0f
#define zMid 1.0f
#define zHigh 1.0f
#define zFalse 0
#define z0 (0.50f * _fmaxf(1.0f - 0.90f * grBias, 0.0f))
#define z1 (0.80f * _fmaxf(1.0f - 0.675f * grBias, 0.0f))
#define z2 (1.00f * _fmaxf(1.0f - 0.45f * grBias, 0.0f))
#define z3 (1.10f * _fmaxf(1.0f - 0.225f * grBias, 0.0f))
#define z4 (1.00f)
#define z5 (0.85f * _fmaxf(1.0f + 0.225f * grBias, 0.0f))
#define z6 (0.65f * _fmaxf(1.0f + 0.45f * grBias, 0.0f))
#define z7 (0.45f * _fmaxf(1.0f + 0.675f * grBias, 0.0f))
#define z8 (0.25f * _fmaxf(1.0f + 0.90f * grBias, 0.0f))
#define halOn (halStrength > 0.0f)
#define halSoft 0.15f
#define halSat 1.0f
