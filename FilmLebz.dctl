    case 2: a=1.13030218f;b=-0.02039285f;c=-0.10990933f;d=-0.02554706f;e=1.31084932f;f_=-0.28530226f;g_=-0.09259861f;h=-0.16465302f;i=1.25725163f;break;
    case 3: a=1.10091538f;b=0.00490402f;c=-0.10581940f;d=-0.02318102f;e=1.30457632f;f_=-0.28139529f;g_=-0.08508715f;h=-0.12776392f;i=1.21285107f;break;
